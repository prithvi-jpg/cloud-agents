{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hci-agent-test-lab/manifest.schema.json",
  "title": "HCI Agent Test Lab Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "created_at",
    "target",
    "mission",
    "authority",
    "cohort",
    "status"
  ],
  "properties": {
    "schema_version": { "const": "0.1" },
    "run_id": { "type": "string", "minLength": 3 },
    "created_at": { "type": "string" },
    "target": {
      "type": "object",
      "required": ["name", "workspace", "url"],
      "properties": {
        "name": { "type": "string" },
        "workspace": { "type": "string" },
        "url": { "type": "string" }
      }
    },
    "mission": { "type": "string", "minLength": 8 },
    "authority": {
      "type": "object",
      "required": ["mode", "forbidden"],
      "properties": {
        "mode": { "enum": ["read-only", "sandbox-write"] },
        "forbidden": { "type": "array", "items": { "type": "string" } }
      }
    },
    "cohort": { "type": "array", "minItems": 1 },
    "status": { "type": "string" }
  }
}
