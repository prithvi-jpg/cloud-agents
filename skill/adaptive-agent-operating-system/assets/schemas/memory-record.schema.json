{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/prithvi-jpg/cloud-agents/main/skill/adaptive-agent-operating-system/assets/schemas/memory-record.schema.json",
  "title": "Agent Systems Foundry Memory Record",
  "type": "object",
  "required": [
    "id",
    "type",
    "scope",
    "status",
    "created_at",
    "updated_at",
    "source_refs",
    "confidence",
    "privacy",
    "tags",
    "related",
    "supersedes",
    "stale_after",
    "body"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$" },
    "type": {
      "enum": ["preference", "decision", "fact", "lesson", "failure", "procedure", "checkpoint"]
    },
    "scope": { "type": "string", "minLength": 1 },
    "status": {
      "enum": ["active", "tentative", "superseded", "stale", "rejected"]
    },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "confidence": { "enum": ["observed", "confirmed", "inferred"] },
    "privacy": { "enum": ["public", "internal", "sensitive"] },
    "tags": { "type": "array", "items": { "type": "string" } },
    "related": { "type": "array", "items": { "type": "string" } },
    "supersedes": { "type": "array", "items": { "type": "string" } },
    "stale_after": { "type": ["string", "null"], "format": "date-time" },
    "body": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": true
}
