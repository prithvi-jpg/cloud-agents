{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/prithvi-jpg/cloud-agents/main/skill/adaptive-agent-operating-system/assets/schemas/run-event.schema.json",
  "title": "Agent Systems Foundry Run Event",
  "type": "object",
  "required": [
    "id",
    "task_id",
    "run_id",
    "timestamp",
    "actor",
    "event",
    "effect_class",
    "status",
    "evidence_refs",
    "payload"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "task_id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "attempt_id": { "type": ["string", "null"] },
    "timestamp": { "type": "string", "format": "date-time" },
    "actor": { "type": "string", "minLength": 1 },
    "event": { "type": "string", "minLength": 1 },
    "from_state": { "type": ["string", "null"] },
    "to_state": { "type": ["string", "null"] },
    "effect_class": {
      "enum": ["read_only", "local_reversible", "external", "destructive", "approval"]
    },
    "status": { "enum": ["ok", "failed", "blocked", "needs_approval"] },
    "idempotency_key": { "type": ["string", "null"] },
    "evidence_refs": { "type": "array", "items": { "type": "string" } },
    "payload": { "type": "object" }
  },
  "additionalProperties": true
}
